{
  "kind": "collectionType",
  "collectionName": "packages",
  "info": {
    "singularName": "package",
    "pluralName": "packages",
    "displayName": "package"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Places": {
      "type": "component",
      "component": "place.places",
      "repeatable": true
    },
    "Itenary": {
      "type": "component",
      "component": "itenary.itenary",
      "repeatable": true
    },
    "Overview": {
      "type": "text"
    },
    "Description": {
      "type": "text"
    },
    "Title": {
      "type": "string"
    },
    "Days": {
      "type": "integer"
    },
    "Nights": {
      "type": "integer"
    },
    "Slug": {
      "type": "string"
    },
    "Image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "country": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::country.country"
    },
    "continent": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::continent.continent"
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "package"
    }
  }
}
